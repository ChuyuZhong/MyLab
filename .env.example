# Copy to .env.local (ignored by Git). Used by npm run bridge only.
# X API outbound proxy; GPU and WeChat stay direct.
MYLAB_PROXY_URL=http://127.0.0.1:7897
# Optional self-hosted full-text RSS services. Only /feed* paths are allowed.
MYLAB_LOCAL_FEED_ORIGINS=http://127.0.0.1:8001,http://127.0.0.1:4000

# Private GPU templates and CLI (keep actual paths in .env.local).
# MYLAB_GPU_CONFIG_DIR=D:/your-config-directory
# MYLAB_GPU_CONFIG_PREFIX=zcy_task
# MYLAB_DET_EXE=C:/your-conda-env/Scripts/det.exe
# MYLAB_GPU_MONITOR_URL=http://your-lab-host:5005/

# Optional Python override for the cluster dashboard (same environment as Determined).
# MYLAB_GPU_PYTHON=C:/your-conda-env/python.exe
